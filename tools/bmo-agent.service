# Template rendered by setup.sh --install-service (@USER@, @REPO@, @PYTHON@).
# Restart=always: BMO comes back even after a clean exit (QUIT), so it is always live.
[Unit]
Description=BMO thin client
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ -m app --headless
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
SupplementaryGroups=audio video input

[Install]
WantedBy=multi-user.target
