{
  "server_url": "http://192.168.0.240:8765",
  "token_file": "/etc/bmo/token",
  "model": "bmo-qwen3-vl-8b",
  "audio_stream": true,

  "microphone": {
    "device": "auto",
    "match": "USB PnP Sound Device",
    "fallback_device": "plughw:1,0",
    "alsa_card": null,
    "capture_rate": 48000,
    "upload_rate": 16000,
    "channels": 1,
    "gain_db": 18,
    "set_capture_gain": true,
    "auto_gain_control": true,
    "backend": "auto",
    "stream_rate": 16000
  },

  "speaker": {
    "device": "auto",
    "match": "UACDemoV1.0",
    "fallback_device": "plughw:2,0",
    "alsa_card": null,
    "set_volume": true,
    "volume_control": "PCM",
    "volume": "50%"
  },

  "camera": {
    "enabled": true,
    "width": 640,
    "height": 480,
    "rotation": 0,
    "vision_mode": "manual"
  },

  "ui": {
    "enabled": true,
    "width": 800,
    "height": 480,
    "fullscreen": true,
    "face_style": "svg",
    "text_only": false
  },

  "sounds": {
    "enabled": true,
    "greeting": true,
    "ack": true,
    "thinking": true
  },

  "input": {
    "evdev_enabled": true,
    "evdev_device": "auto"
  },

  "web": {
    "enabled": true,
    "port": 8080,
    "pin_file": "~/.config/bmo/web_pin",
    "tls": "off",
    "tls_port": 8443,
    "http_redirect": true,
    "cert_file": "~/.config/bmo/tls/cert.pem",
    "key_file": "~/.config/bmo/tls/key.pem",
    "tls_hostnames": [],
    "trusted_proxies": [],
    "public_origins": [],
    "max_voice_bytes": 3000000
  },

  "wake_word": {
    "enabled": false,
    "model": "hey_jarvis",
    "custom_model": "models/hey_bmo.onnx",
    "threshold": 0.5,
    "cooldown_seconds": 2.0
  },

  "listen": {
    "vad": "silero",
    "end_silence_seconds": 0.9,
    "no_speech_timeout": 6.0,
    "followup": true,
    "followup_seconds": 5.0,
    "followup_min_speech_seconds": 0.15,
    "preroll_seconds": 0.4,
    "auto_stop_button": true,
    "mute_tail_seconds": 0.6,
    "prewarm_on_wake": true
  },

  "memory": {
    "enabled": true,
    "max_messages": 10,
    "max_chars": 6000,
    "session_idle_minutes": 30
  }
}
