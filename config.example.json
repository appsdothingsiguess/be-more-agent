{
  "server_url": "http://192.168.0.240:8765",
  "token_file": "/etc/bmo/token",
  "model": "bmo-qwen3-vl-8b",

  "microphone": {
    "device": "auto",
    "match": "USB PnP Sound Device",
    "fallback_device": "plughw:1,0",
    "alsa_card": null,
    "capture_rate": 48000,
    "upload_rate": 16000,
    "channels": 1,
    "gain_db": 18,
    "set_capture_gain": true,
    "auto_gain_control": true
  },

  "speaker": {
    "device": "auto",
    "match": "UACDemoV1.0",
    "fallback_device": "plughw:2,0",
    "alsa_card": null,
    "set_volume": true,
    "volume_control": "PCM",
    "volume": "50%"
  },

  "camera": {
    "enabled": true,
    "width": 640,
    "height": 480,
    "rotation": 0,
    "vision_mode": "manual"
  },

  "ui": {
    "enabled": true,
    "width": 800,
    "height": 480,
    "fullscreen": true,
    "text_only": false
  },

  "sounds": {
    "enabled": true,
    "greeting": true,
    "ack": true,
    "thinking": true
  },

  "input": {
    "evdev_enabled": true,
    "evdev_device": "auto"
  },

  "web": {
    "enabled": true,
    "port": 8080,
    "pin_file": "~/.config/bmo/web_pin"
  },

  "wake_word": {
    "enabled": false
  }
}
